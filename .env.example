# DunningBee Environment Variables
# Copy this to .env.local and fill in your values

# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection for Drizzle ORM
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Stripe ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_CLIENT_ID=ca_...

# DunningBee's own Stripe price IDs (for billing customers)
STRIPE_PRICE_STARTER=price_...   # $19/mo
STRIPE_PRICE_GROWTH=price_...    # $39/mo
STRIPE_PRICE_SCALE=price_...     # $79/mo

# ── Resend (email) ────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=recover@dunningbee.com

# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
